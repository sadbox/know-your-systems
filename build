#!/bin/sh
# Builds the PDFs (./out) and the website (./site) in the pinned container, exactly as CI does.
# Arguments go to the generator, e.g. ./build -edition "March 2027".
set -eu
cd "$(dirname "$0")"
# The commit the files were built from, for the print-kit page ("-dirty": uncommitted changes).
commit=$(git describe --always --dirty 2>/dev/null || echo unknown)
exec ./kys -site site -commit "$commit" "$@"
