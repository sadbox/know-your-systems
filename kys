#!/bin/sh
# Runs the generator in the pinned container (Dockerfile) on this checkout. Arguments go to it,
# e.g. ./kys -links, ./kys -facts, ./kys -diff old-out. ./build is the usual way to build.
#
# The base image (base/Dockerfile: Debian, Chromium) is pulled from GHCR by its tag (base/tag).
# It's public, so no login is needed. Pulling is the only way to get it, with one exception: a
# change to base/Dockerfile isn't published until it's merged, so for that change alone build it
# with KYS_BUILD_BASE=1 (the only step that reaches snapshot.debian.org). CI sets that only when a
# change touches base/.
set -eu
cd "$(dirname "$0")"
base="ghcr.io/sadbox/know-your-systems-base:$(base/tag)"
if [ "${KYS_BUILD_BASE:-}" = 1 ]; then
	echo "kys: building $base from base/Dockerfile (KYS_BUILD_BASE=1)" >&2
	docker build --quiet --tag "$base" base >/dev/null
elif ! docker image inspect "$base" >/dev/null 2>&1 && ! docker pull --quiet "$base" >/dev/null; then
	cat >&2 <<MSG
kys: can't pull $base.
  - Offline, or GHCR down? Try again later; nothing here builds it for you.
  - Changing base/Dockerfile? It isn't published until merged: KYS_BUILD_BASE=1 ./build
MSG
	exit 1
fi
docker build --quiet --build-arg "BASE=$base" --tag kys:local . >/dev/null
exec docker run --rm --user "$(id -u):$(id -g)" --volume "$PWD:/work" kys:local "$@"
